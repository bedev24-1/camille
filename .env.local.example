# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — Camille by Buyticle
# Copy to .env.local and fill in your values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (self-hosted Supabase) ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your-password@supabase.vps.buyticle.com:5432/postgres

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Génère avec : openssl rand -base64 32
JWT_SECRET=change-me-generate-a-random-secret

# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# ── Waha (WhatsApp HTTP API) ───────────────────────────────────────────────────
WAHA_URL=https://waha.vps.buyticle.com
WAHA_API_KEY=your-waha-api-key

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═════════════════════ WhatsApp Cloud API (Meta) ═════════════════════
# Deuxième transport, à côté de camille-core. Un agent n'y passe que si
# agents.transport = 'meta' — le défaut 'core' garde tous les clients
# existants sur le chemin actuel.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
CATALOG_ID=
GRAPH_VERSION=v26.0

# Chaîne libre, à recopier dans la configuration du webhook côté Meta.
WHATSAPP_VERIFY_TOKEN=
# Secret de l'application Meta. Sans lui la signature des messages entrants
# n'est PAS vérifiée : tolérable pour un test sur son propre numéro,
# inacceptable dès qu'un marchand est dessus.
WHATSAPP_APP_SECRET=

# Repli de test : l'agent visé tant que agents.meta_phone_number_id n'est pas
# renseigné. Permet d'essayer sans imposer de migration.
META_TEST_AGENT_ID=

# ═════════════════════ La compréhension (CVA) ════════════════════════
# Le modèle qui lit le message du client et dit ce qu'il veut. Sans clé, le
# flux Meta reste entièrement fonctionnel : il retombe sur le repli
# déterministe — dégradé, mais il ne mentira pas.
#
# Compatible OpenAI : Groq, Cerebras, OpenAI, ou un modèle auto-hébergé.
IA_BASE_URL=https://api.groq.com/openai/v1
IA_KEY=
# Plusieurs modèles séparés par des virgules : à la première saturation on
# passe au suivant. Chez Groq la limite de jetons par minute est comptée PAR
# MODÈLE (8000 sur l'offre gratuite), donc trois modèles = trois fois la
# capacité, gratuitement. Vérifié : llama-3.3-70b-versatile N'EXISTE PLUS.
IA_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# ═════════════════════ Le mode d'emploi en vidéo ═════════════════════
# Proposée au PREMIER message d'un client, une seule fois. L'URL doit être
# publique, en video/mp4, sous 16 Mo : Meta la télécharge lui-même. Un lien
# de partage Drive ou Dropbox ne marche pas — il renvoie une page HTML.
# Sans URL, une vidéo de démonstration publique est utilisée (15 s, 11,9 Mo).
TUTO_VIDEO_URL=

# ═════════════════════ Mémoire client ═══════════════════════════════
# Rien à régler. Les commandes passées se lisent dans camille.orders ;
# les goûts dans camille.contacts.notes, ajouté par
# migration_memoire_client.sql. Sans cette migration, Camille se
# souvient quand même des commandes — la mémoire est juste plus pauvre.

# Durée de vie du cache de compréhension, en secondes (défaut 600).
# Le cache évite de rappeler le modèle pour une question déjà posée mot pour
# mot avec le même catalogue. Mesuré sur un trafic réaliste : 6 appels sur 10
# évités, et le quota Groq passe de 5 à 12 messages par minute.
IA_CACHE_TTL_S=600
